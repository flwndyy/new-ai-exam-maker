# Temporary HTTP-only Nginx configuration for Let's Encrypt HTTP-01.
# Install this before requesting the certificate. Replace the domain placeholder.

server {
    listen 80;
    listen [::]:80;
    server_name origin.example.invalid;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
