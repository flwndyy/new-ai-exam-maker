# Deploy as /etc/exammaker/origin-secret.conf with mode 0640 and owner root:nginx.
# Replace the placeholder only on the EC2 host using a value from Parameter Store.
# Never commit the deployed file or its value.

map $http_x_origin_verify $origin_header_valid {
    default 0;
    "REPLACE_WITH_PARAMETER_STORE_ORIGIN_SECRET" 1;
}
