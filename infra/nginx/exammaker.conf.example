# Nginx origin template for origin.<domain>.
# The secret map is intentionally stored in a separate root-owned include.
# The Security Group remains the primary network restriction: 443 from CloudFront only,
# 80 for Let's Encrypt HTTP-01, and no SSH ingress.

include /etc/exammaker/origin-secret.conf;

upstream exammaker_api {
    server 127.0.0.1:5000;
}

server {
    listen 80;
    listen [::]:80;
    server_name origin.example.invalid;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name origin.example.invalid;

    ssl_certificate /etc/letsencrypt/live/origin.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/origin.example.invalid/privkey.pem;

    if ($origin_header_valid = 0) {
        return 403;
    }

    location / {
        proxy_pass http://exammaker_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Do not forward the shared origin secret to Kestrel or application logs.
        proxy_set_header X-Origin-Verify "";
    }
}
