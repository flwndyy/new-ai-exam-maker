{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListFrontendBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${FRONTEND_BUCKET_ARN}"
    },
    {
      "Sid": "ManageFrontendObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${FRONTEND_BUCKET_OBJECT_ARN}"
    },
    {
      "Sid": "InvalidateFrontendDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "${CLOUDFRONT_DISTRIBUTION_ARN}"
    }
  ]
}
