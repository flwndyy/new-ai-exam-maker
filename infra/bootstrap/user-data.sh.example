#!/usr/bin/env bash
set -Eeuo pipefail

# Mẫu O1 cho EC2 Amazon Linux 2023 ARM64 (t4g.small).
# Chạy sau khi O2/O3 đã tạo instance và gắn role least-privilege.
# Do not put passwords, tokens, private keys, IDs, or ARNs in this file.

APP_USER="exammaker"
APP_ROOT="/opt/exammaker"

dnf update -y
dnf install -y nginx jq python3 python3-pip augeas-libs

id "${APP_USER}" >/dev/null 2>&1 || useradd --system --home-dir "${APP_ROOT}" --shell /sbin/nologin "${APP_USER}"
install -d -o "${APP_USER}" -g "${APP_USER}" -m 0750 \
  "${APP_ROOT}/releases" "${APP_ROOT}/shared"
install -d -o root -g nginx -m 0750 /etc/exammaker
install -d -o root -g nginx -m 0755 /var/www/letsencrypt

# API/Worker được publish self-contained cho linux-arm64, nên không cần cài .NET runtime.
# Nếu đổi sang framework-dependent publish, phải cài đúng .NET runtime ARM64 trước O15.

# Certbot không được giả định có sẵn trong repo AL2023. Cài vào virtualenv riêng để
# không làm thay đổi Python hệ thống. Chỉ cấp chứng chỉ sau khi O4 đã cài config HTTP-only.
CERTBOT_VENV="/opt/certbot"
if [ ! -x "${CERTBOT_VENV}/bin/certbot" ]; then
  python3 -m venv "${CERTBOT_VENV}"
  "${CERTBOT_VENV}/bin/pip" install --upgrade pip
  "${CERTBOT_VENV}/bin/pip" install certbot
fi
ln -sfn "${CERTBOT_VENV}/bin/certbot" /usr/local/bin/certbot

# Copy the reviewed files from this repository during O3/O4/O15 deployment:
#   infra/nginx/exammaker.conf.example
#   infra/nginx/acme-http.conf.example
#   infra/nginx/origin-secret.conf.example
#   infra/systemd/exammaker-api.service.example
#   infra/systemd/exammaker-worker.service.example
#   infra/systemd/certbot-renew.service.example
#   infra/systemd/certbot-renew.timer.example
#   infra/certbot/renewal-hooks/deploy/10-reload-nginx.sh.example
#
# Supply runtime configuration through /etc/exammaker/api.env and worker.env.
# Secrets must come from Parameter Store or another approved deployment step.
# Nginx intentionally remains stopped until O4 installs the HTTP-only ACME config.

echo "Bootstrap prerequisites installed. Continue with the AWS runbook before starting Nginx or the application."
