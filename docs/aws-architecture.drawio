        <!-- ===================== Title ===================== -->
        <mxCell id="title" value="&lt;b&gt;AI Exam Maker: kiến trúc AWS (MVP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#5A6C86&quot;&gt;Phương án A: CloudFront phục vụ frontend tĩnh từ S3 qua OAC, /api/* đi tới EC2. Không ALB, không NAT Gateway, không Multi-AZ. Bản vẽ 26/11/2026, khớp docs/context.md v0.26.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="200" y="0" width="1500" height="40" as="geometry" />
        </mxCell>

